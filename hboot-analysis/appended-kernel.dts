	thermal-zones {

		cpu-thermal {
			polling-delay-passive = <0x3e8>;
			polling-delay = <0x00>;
			thermal-sensors = <0x21 0x00>;

			trips {

				cpu_shutdown_trip {
					temperature = <0x17318>;
					hysteresis = <0x3e8>;
					type = "critical";
				};

				throttle-trip {
					temperature = <0x14438>;
					hysteresis = <0x3e8>;
					type = "passive";
					phandle = <0x22>;
				};

				cpu_shutdown_warn {
					temperature = <0x16b48>;
					hysteresis = <0x00>;
					type = "hot";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x22>;
					cooling-device = <0x23 0x01 0x01>;
				};
			};
		};

		mem-thermal {
			polling-delay-passive = <0x00>;
			polling-delay = <0x00>;
			thermal-sensors = <0x21 0x01>;

			trips {

				mem_shutdown_trip {
					temperature = <0x17318>;
					hysteresis = <0x3e8>;
					type = "critical";
				};

				mem_throttle_trip {
					temperature = <0x14438>;
					hysteresis = <0x3e8>;
					type = "passive";
				};

				mem_shutdown_warn {
					temperature = <0x16b48>;
					hysteresis = <0x00>;
					type = "hot";
				};
			};

			cooling-maps {
			};
		};

		gpu-thermal {
			polling-delay-passive = <0x3e8>;
			polling-delay = <0x00>;
			thermal-sensors = <0x21 0x02>;

			trips {

				gpu_shutdown_trip {
					temperature = <0x17318>;
					hysteresis = <0x3e8>;
					type = "critical";
				};

				throttle-trip {
					temperature = <0x14438>;
					hysteresis = <0x3e8>;
					type = "passive";
					phandle = <0x24>;
				};

				gpu_shutdown_warn {
					temperature = <0x16b48>;
					hysteresis = <0x00>;
					type = "hot";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x24>;
					cooling-device = <0x23 0x01 0x01>;
				};
			};
		};

		pllx-thermal {
			polling-delay-passive = <0x00>;
			polling-delay = <0x00>;
			thermal-sensors = <0x21 0x03>;

			trips {

				pllx_shutdown_trip {
					temperature = <0x17318>;
					hysteresis = <0x3e8>;
					type = "critical";
				};

				pllx_throttle_trip {
					temperature = <0x14438>;
					hysteresis = <0x3e8>;
					type = "passive";
				};

				pllx_shutdown_warn {
					temperature = <0x16b48>;
					hysteresis = <0x00>;
					type = "hot";
				};
			};

			cooling-maps {
			};
		};
	};

	ahub@70300000 {
		compatible = "nvidia,tegra124-ahub";
		reg = <0x00 0x70300000 0x00 0x200 0x00 0x70300800 0x00 0x800 0x00 0x70300200 0x00 0x600>;
		interrupts = <0x00 0x67 0x04>;
		clocks = <0x03 0x6a 0x03 0x6b>;
		clock-names = "d_audio", "apbif";
		resets = <0x03 0x6a 0x03 0x6b 0x03 0x1e 0x03 0x0b 0x03 0x12 0x03 0x65 0x03 0x66 0x03 0x6c 0x03 0x6d 0x03 0x6e 0x03 0x0a 0x03 0x99 0x03 0xb9 0x03 0x9a 0x03 0xb4 0x03 0xba 0x03 0xbb 0x03 0xbc 0x03 0xbd 0x03 0xbe 0x03 0xbf>;
		reset-names = "d_audio", "apbif", "i2s0", "i2s1", "i2s2", "i2s3", "i2s4", "dam0", "dam1", "dam2", "spdif", "amx", "amx1", "adx", "adx1", "afc0", "afc1", "afc2", "afc3", "afc4", "afc5";
		dmas = <0x11 0x01 0x11 0x01 0x11 0x02 0x11 0x02 0x11 0x03 0x11 0x03 0x11 0x04 0x11 0x04 0x11 0x06 0x11 0x06 0x11 0x07 0x11 0x07 0x11 0x0c 0x11 0x0c 0x11 0x0d 0x11 0x0d 0x11 0x0e 0x11 0x0e 0x11 0x1d 0x11 0x1d>;
		dma-names = "rx0", "tx0", "rx1", "tx1", "rx2", "tx2", "rx3", "tx3", "rx4", "tx4", "rx5", "tx5", "rx6", "tx6", "rx7", "tx7", "rx8", "tx8", "rx9", "tx9";
		ranges;
		#address-cells = <0x02>;
		#size-cells = <0x02>;

		i2s@70301000 {
			compatible = "nvidia,tegra124-i2s";
			reg = <0x00 0x70301000 0x00 0x100>;
			nvidia,ahub-cif-ids = <0x04 0x04>;
			clocks = <0x03 0x1e>;
			clock-names = "i2s";
			resets = <0x03 0x1e>;
			reset-names = "i2s";
			status = "okay";
		};

		i2s@70301100 {
			compatible = "nvidia,tegra124-i2s";
			reg = <0x00 0x70301100 0x00 0x100>;
			nvidia,ahub-cif-ids = <0x05 0x05>;
			clocks = <0x03 0x0b>;
			clock-names = "i2s";
			resets = <0x03 0x0b>;
			reset-names = "i2s";
			status = "okay";
		};

		i2s@70301200 {
			compatible = "nvidia,tegra124-i2s";
			reg = <0x00 0x70301200 0x00 0x100>;
			nvidia,ahub-cif-ids = <0x06 0x06>;
			clocks = <0x03 0x12>;
			clock-names = "i2s";
			resets = <0x03 0x12>;
			reset-names = "i2s";
			status = "okay";
		};

		i2s@70301300 {
			compatible = "nvidia,tegra124-i2s";
			reg = <0x00 0x70301300 0x00 0x100>;
			nvidia,ahub-cif-ids = <0x07 0x07>;
			clocks = <0x03 0x65>;
			clock-names = "i2s";
			resets = <0x03 0x65>;
			reset-names = "i2s";
			status = "okay";
		};

		i2s@70301400 {
			compatible = "nvidia,tegra124-i2s";
			reg = <0x00 0x70301400 0x00 0x100>;
			nvidia,ahub-cif-ids = <0x08 0x08>;
			clocks = <0x03 0x66>;
			clock-names = "i2s";
			resets = <0x03 0x66>;
			reset-names = "i2s";
			status = "disabled";
		};
	};

	usb@7d000000 {
		compatible = "nvidia,tegra124-udc";
		reg = <0x00 0x7d000000 0x00 0x4000>;
		interrupts = <0x00 0x14 0x04>;
		phy_type = "utmi";
		clocks = <0x03 0x16>;
		clock-names = "usb";
		resets = <0x03 0x16>;
		reset-names = "usb";
		nvidia,phy = <0x25>;
		status = "okay";
		dr_mode = "otg";
		extcon = <0x26 0x27>;
		vbus-supply = <0x1f>;
	};

	usb-phy@7d000000 {
		compatible = "nvidia,tegra124-usb-phy", "nvidia,tegra30-usb-phy";
		reg = <0x00 0x7d000000 0x00 0x4000 0x00 0x7d000000 0x00 0x4000>;
		interrupts = <0x00 0x14 0x04>;
		phy_type = "utmi";
		clocks = <0x03 0x16 0x03 0xde 0x03 0x16>;
		clock-names = "reg", "pll_u", "utmi-pads";
		resets = <0x03 0x16 0x03 0x16>;
		reset-names = "usb", "utmi-pads";
		#phy-cells = <0x00>;
		nvidia,hssync-start-delay = <0x00>;
		nvidia,idle-wait-delay = <0x11>;
		nvidia,elastic-limit = <0x10>;
		nvidia,term-range-adj = <0x06>;
		nvidia,xcvr-setup = <0x09>;
		nvidia,xcvr-lsfslew = <0x00>;
		nvidia,xcvr-lsrslew = <0x03>;
		nvidia,hssquelch-level = <0x02>;
		nvidia,hsdiscon-level = <0x05>;
		nvidia,xcvr-hsslew = <0x0c>;
		nvidia,has-utmi-pad-registers;
		nvidia,pmc = <0x28 0x00>;
		status = "okay";
		dr_mode = "otg";
		vbus-supply = <0x1e>;
		phandle = <0x25>;
	};

	usb@7d004000 {
		compatible = "nvidia,tegra124-ehci", "nvidia,tegra30-ehci";
		reg = <0x00 0x7d004000 0x00 0x4000>;
		interrupts = <0x00 0x15 0x04>;
		phy_type = "utmi";
		clocks = <0x03 0x3a>;
		clock-names = "usb";
		resets = <0x03 0x3a>;
		reset-names = "usb";
		nvidia,phy = <0x29>;
		status = "disabled";
	};

	usb-phy@7d004000 {
		compatible = "nvidia,tegra124-usb-phy", "nvidia,tegra30-usb-phy";
		reg = <0x00 0x7d004000 0x00 0x4000 0x00 0x7d000000 0x00 0x4000>;
		interrupts = <0x00 0x15 0x04>;
		phy_type = "utmi";
		clocks = <0x03 0x3a 0x03 0xde 0x03 0x16>;
		clock-names = "reg", "pll_u", "utmi-pads";
		resets = <0x03 0x3a 0x03 0x16>;
		reset-names = "usb", "utmi-pads";
		#phy-cells = <0x00>;
		nvidia,hssync-start-delay = <0x00>;
		nvidia,idle-wait-delay = <0x11>;
		nvidia,elastic-limit = <0x10>;
		nvidia,term-range-adj = <0x06>;
		nvidia,xcvr-setup = <0x09>;
		nvidia,xcvr-lsfslew = <0x00>;
		nvidia,xcvr-lsrslew = <0x03>;
		nvidia,hssquelch-level = <0x02>;
		nvidia,hsdiscon-level = <0x05>;
		nvidia,xcvr-hsslew = <0x0c>;
		nvidia,pmc = <0x28 0x01>;
		status = "disabled";
		phandle = <0x29>;
	};

	usb@7d008000 {
		compatible = "nvidia,tegra124-ehci", "nvidia,tegra30-ehci";
		reg = <0x00 0x7d008000 0x00 0x4000>;
		interrupts = <0x00 0x61 0x04>;
		phy_type = "utmi";
		clocks = <0x03 0x3b>;
		clock-names = "usb";
		resets = <0x03 0x3b>;
		reset-names = "usb";
		nvidia,phy = <0x2a>;
		status = "disabled";
	};

	usb-phy@7d008000 {
		compatible = "nvidia,tegra124-usb-phy", "nvidia,tegra30-usb-phy";
		reg = <0x00 0x7d008000 0x00 0x4000 0x00 0x7d000000 0x00 0x4000>;
		interrupts = <0x00 0x61 0x04>;
		phy_type = "utmi";
		clocks = <0x03 0x3b 0x03 0xde 0x03 0x16>;
		clock-names = "reg", "pll_u", "utmi-pads";
		resets = <0x03 0x3b 0x03 0x16>;
		reset-names = "usb", "utmi-pads";
		#phy-cells = <0x00>;
		nvidia,hssync-start-delay = <0x00>;
		nvidia,idle-wait-delay = <0x11>;
		nvidia,elastic-limit = <0x10>;
		nvidia,term-range-adj = <0x06>;
		nvidia,xcvr-setup = <0x09>;
		nvidia,xcvr-lsfslew = <0x00>;
		nvidia,xcvr-lsrslew = <0x03>;
		nvidia,hssquelch-level = <0x02>;
		nvidia,hsdiscon-level = <0x05>;
		nvidia,xcvr-hsslew = <0x0c>;
		nvidia,pmc = <0x28 0x02>;
		status = "disabled";
		phandle = <0x2a>;
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "nvidia,tegra132-denver";
			reg = <0x00>;
			enable-method = "spin-table";
			cpu-release-addr = <0x8000fff8>;
			clocks = <0x2b 0x01 0x2b 0x02 0x03 0xd3 0x2c>;
			clock-names = "cpu_g", "pll_x", "pll_p", "dfll";
			clock-latency = <0x493e0>;
			vdd-cpu-supply = <0x1b>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "nvidia,tegra132-denver";
			reg = <0x01>;
			enable-method = "spin-table";
			cpu-release-addr = <0x8000fff8>;
		};
	};

	timer {
		compatible = "arm,armv7-timer";
		interrupts = <0x01 0x0d 0xf08 0x01 0x0e 0xf08 0x01 0x0b 0xf08 0x01 0x0a 0xf08>;
		interrupt-parent = <0x02>;
	};

	aliases {
		i2c0 = "/i2c@7000c000";
		i2c1 = "/i2c@7000c400";
		i2c2 = "/i2c@7000c500";
		i2c4 = "/i2c@7000d000";
		spi2 = "/spi@7000d800";
		spi3 = "/spi@7000da00";
		spi4 = "/spi@7000dc00";
		rtc0 = "/i2c@7000d000/tps65913@58/rtc";
		rtc1 = "/rtc@7000e000";
		mmc0 = "/mmc@700b0600";
		mmc1 = "/mmc@700b0000";
	};

	chosen {
		stdout-path = "/serial@70006000:115200n8";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		framebuffer@ac001000 {
			compatible = "simple-framebuffer";
			reg = <0x00 0xac001000 0x00 0xc20000>;
			width = <0x600>;
			height = <0x800>;
			stride = <0x1800>;
			format = "a8b8g8r8";
			clocks = <0x03 0x1b 0x03 0x30 0x03 0x52>;
			dsi-supply = <0x06>;
			lcd-supply = <0x08>;
			io-supply = <0x09>;
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0x80000000>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		framebuffer@ac001000 {
			reg = <0x00 0xac001000 0x00 0xc20000>;
			no-map;
		};
	};

	pwrseq-wifi {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <0x0a 0xbf 0x01>;
		post-power-on-delay-ms = <0x12c>;
		power-off-delay-us = <0x12c>;
		phandle = <0x20>;
	};

	extcon-usb-gpio {
		compatible = "linux,extcon-usb-gpio";
		id-gpio = <0x0a 0xb2 0x00>;
		phandle = <0x27>;
	};

	clock-32k {
		compatible = "fixed-clock";
		clock-frequency = <0x8000>;
		#clock-cells = <0x00>;
		phandle = <0x19>;
	};

	gpio-keys {
		compatible = "gpio-keys";

		power {
			label = "Power";
			gpios = <0x0a 0x80 0x01>;
			linux,code = <0x74>;
			debounce-interval = <0x14>;
			wakeup-source;
		};

		volume_down {
			label = "Volume Down";
			gpios = <0x0a 0x85 0x01>;
			linux,code = <0x72>;
			debounce-interval = <0x14>;
		};

		volume_up {
			label = "Volume Up";
			gpios = <0x0a 0xaa 0x01>;
			linux,code = <0x73>;
			debounce-interval = <0x14>;
		};
	};

	vibrator {
		compatible = "gpio-vibrator";
		enable-gpios = <0x0a 0xa3 0x00>;
		vcc-supply = <0x16>;
	};

	regulator-vdd-battery {
		compatible = "regulator-fixed";
		regulator-name = "vdd-battery";
		regulator-always-on;
		regulator-boot-on;
		phandle = <0x16>;
	};

	regulator-avdd-lcd {
		compatible = "regulator-fixed";
		regulator-name = "avdd-lcd";
		gpio = <0x0a 0x88 0x00>;
		enable-active-high;
		regulator-boot-on;
		vin-supply = <0x16>;
		phandle = <0x08>;
	};

	regulator-iovdd-lcd {
		compatible = "regulator-fixed";
		regulator-name = "iovdd-lcd";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		gpio = <0x0a 0x82 0x00>;
		enable-active-high;
		regulator-boot-on;
		vin-supply = <0x17>;
		phandle = <0x09>;
	};
};
