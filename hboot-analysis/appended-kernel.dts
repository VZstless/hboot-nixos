		tps65913@58 {
			compatible = "ti,tps65913", "ti,palmas";
			reg = <0x58>;
			interrupts = <0x00 0x56 0x00>;
			#interrupt-cells = <0x02>;
			interrupt-controller;
			ti,system-power-controller;
			phandle = <0x14>;

			gpio {
				compatible = "ti,tps65913-gpio";
				gpio-controller;
				#gpio-cells = <0x02>;
			};

			rtc {
				compatible = "ti,palmas-rtc";
				interrupt-parent = <0x14>;
				interrupts = <0x08 0x00>;
			};

			pinctrl {
				compatible = "ti,tps65913-pinctrl";
				pinctrl-names = "default";
				pinctrl-0 = <0x15>;

				pinmux {
					phandle = <0x15>;

					powergood {
						pins = "powergood";
						function = "powergood";
					};

					vac {
						pins = "vac";
						function = "vac";
					};

					pin_gpio0 {
						pins = "gpio0";
						function = "id";
						bias-pull-up;
					};

					pin_gpio1 {
						pins = "gpio1";
						function = "vbus_det";
					};

					pin_gpio7 {
						pins = "gpio2", "gpio3", "gpio4", "gpio6", "gpio7";
						function = "gpio";
					};

					pin_gpio5 {
						pins = "gpio5";
						function = "clk32kgaudio";
					};
				};
			};

			palmas-usb {
				compatible = "ti,palmas-usb-vid";
				ti,wakeup;
				ti,enable-vbus-detection;
				phandle = <0x26>;
			};

			clock {
				compatible = "ti,palmas-clk32kg";
				#clock-cells = <0x00>;
			};

			pmic {
				compatible = "ti,tps65913-pmic", "ti,palmas-pmic";
				smps1-in-supply = <0x16>;
				smps4-in-supply = <0x16>;
				smps6-in-supply = <0x16>;
				smps8-in-supply = <0x16>;
				smps9-in-supply = <0x16>;
				smps10-in-supply = <0x16>;
				smps10-out2-supply = <0x16>;
				ldo1-in-supply = <0x16>;
				ldo2-in-supply = <0x17>;
				ldo3-in-supply = <0x16>;
				ldo4-in-supply = <0x16>;
				ldo5-in-supply = <0x17>;
				ldo6-in-supply = <0x16>;
				ldo7-in-supply = <0x17>;
				ldo8-in-supply = <0x16>;
				ldo9-in-supply = <0x16>;
				ldoln-in-supply = <0x18>;
				ldousb-in-supply = <0x16>;

				regulators {

					smps123 {
						regulator-name = "vdd-cpu";
						regulator-min-microvolt = <0x9eb10>;
						regulator-max-microvolt = <0x155cc0>;
						regulator-always-on;
						regulator-boot-on;
						ti,roof-floor = <0x01>;
						phandle = <0x1b>;
					};

					smps457 {
						regulator-name = "vdd-gpu";
						regulator-min-microvolt = <0xaae60>;
						regulator-max-microvolt = <0x155cc0>;
						phandle = <0x0d>;
					};

					smps6 {
						regulator-name = "vdd-core";
						regulator-min-microvolt = <0xaae60>;
						regulator-max-microvolt = <0x155cc0>;
						regulator-always-on;
						regulator-boot-on;
						ti,roof-floor = <0x03>;
					};

					smps8 {
						regulator-name = "vdd-1v8";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-always-on;
						regulator-boot-on;
						phandle = <0x17>;
					};

					smps9 {
						regulator-name = "vdd-1v2";
						regulator-min-microvolt = <0x124f80>;
						regulator-max-microvolt = <0x124f80>;
					};

					smps10_out1 {
						regulator-name = "vdd-hdmi";
						regulator-min-microvolt = <0x4c4b40>;
						regulator-max-microvolt = <0x4c4b40>;
					};

					smps10_out2 {
						regulator-name = "vdd-out2-5v0";
						regulator-min-microvolt = <0x4c4b40>;
						regulator-max-microvolt = <0x4c4b40>;
						regulator-always-on;
						regulator-boot-on;
						phandle = <0x18>;
					};

					ldo1 {
						regulator-name = "avdd-pll";
						regulator-min-microvolt = <0x100590>;
						regulator-max-microvolt = <0x100590>;
						regulator-always-on;
						regulator-boot-on;
						ti,roof-floor = <0x03>;
						phandle = <0x1d>;
					};

					ldo2 {
						regulator-name = "vdd-audio";
						regulator-min-microvolt = <0x124f80>;
						regulator-max-microvolt = <0x124f80>;
					};

					ldo3 {
						regulator-name = "vdd-sensor-io";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
					};

					ldo4 {
						regulator-name = "vdd-sensor-2v85";
						regulator-min-microvolt = <0x2b7cd0>;
						regulator-max-microvolt = <0x2b7cd0>;
						regulator-always-on;
						phandle = <0x12>;
					};

					ldo5 {
						regulator-name = "avdd-dsi-csi";
						regulator-min-microvolt = <0x124f80>;
						regulator-max-microvolt = <0x124f80>;
						regulator-boot-on;
						phandle = <0x06>;
					};

					ldo6 {
						regulator-name = "vdd-1v5-ldo6";
						regulator-min-microvolt = <0x16e360>;
						regulator-max-microvolt = <0x1b7740>;
					};

					ldo7 {
						regulator-name = "dvdd-slimport";
						regulator-min-microvolt = <0xf4240>;
						regulator-max-microvolt = <0x10c8e0>;
					};

					ldo8 {
						regulator-name = "vdd-rtc";
						regulator-min-microvolt = <0xe7ef0>;
						regulator-max-microvolt = <0xe7ef0>;
						regulator-always-on;
						regulator-boot-on;
					};

					ldo9 {
						regulator-name = "vdd-3p3-ldo9";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x325aa0>;
					};

					ldoln {
						regulator-name = "vddio-hv";
						regulator-min-microvolt = <0x325aa0>;
						regulator-max-microvolt = <0x325aa0>;
						ti,roof-floor = <0x03>;
					};

					ldousb {
						regulator-name = "avdd-usb";
						regulator-min-microvolt = <0x325aa0>;
						regulator-max-microvolt = <0x325aa0>;
						phandle = <0x1e>;
					};
				};
			};

			adc {
				compatible = "ti,palmas-gpadc";
				interrupts = <0x12 0x00 0x10 0x00 0x11 0x00>;
				#io-channel-cells = <0x01>;
			};
		};
