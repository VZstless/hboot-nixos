			compatible = "richtek,rt5506-amp";
		};

		ina230x@40 {
			ti,shunt-polartiy-inverted = <0x00>;
			ti,precision-multiplier = <0x01>;
			ti,shunt-resistor-mohm = <0x0a>;
			ti,divisor = <0x19>;
			ti,power-lsb = <0x07>;
			ti,calibration-data = <0xba>;
			ti,resistor = <0x0a>;
			ti,rail-name = "VDD_BAT";
			ti,current-threshold = <0x2328>;
			ti,continuous-config = <0x7207>;
			ti,trigger-config = <0x7203>;
			reg = <0x40>;
			compatible = "ti,ina230x";
		};
	};

	i2c@7000c000 {
		clock-frequency = <0x61a80>;
		status = "okay";
		nvidia,memory-clients = <0x0e>;
		sda-gpio = <0x04 0x15 0x00>;
		scl-gpio = <0x04 0x14 0x00>;
		interrupts = <0x00 0x26 0x04>;
		reg = <0x00 0x7000c000 0x00 0x100>;
		compatible = "nvidia,tegra124-i2c";
		#size-cells = <0x00>;
		#address-cells = <0x01>;

		htc_mcu@72 {
			mcu,Chip_mode-gpio = <0x04 0xa4 0x00>;
			mcu,Reset-gpio = <0x04 0x8a 0x00>;
			mcu,Cpu_wake_mcu-gpio = <0x04 0x81 0x00>;
			mcu,gyro_axes = <0x06>;
			mcu,magnetic_axes = <0x07>;
			mcu,acceleration_axes = <0x06>;
			mcu,gs_chip_layout = <0x01>;
			mcu,intr-gpio = <0x04 0x8c 0x00>;
			interrupts = <0x8c 0x00>;
			interrupt-parent = <0x04>;
			reg = <0x72>;
			compatible = "htc_mcu";
		};

		bq2419x@6b {
			interrupts = <0x48 0x00>;
			interrupt-parent = <0x04>;
			reg = <0x6b>;
			compatible = "ti,bq2419x";

			vbus {
				regulator-name = "vbus_regulator";

				consumers {

					c2 {
						regulator-consumer-device = "tegra-otg";
						regulator-consumer-supply = "usb_vbus";
					};

					c1 {
						regulator-consumer-device = "tegra-ehci.0";
						regulator-consumer-supply = "usb_vbus";
					};
				};
			};
		};

		max17050@36 {
			battery-id-channel-name = "batt-id-channel";
			reg = <0x36>;
			compatible = "maxim,max17050";

			param_adjust_map_by_id {

				id1 {
					temperature-low-parameters = <0xaf59 0x5f86 0x2790>;
					temperature-normal-parameters = <0x964c 0x1032 0x00>;
					temperature-low-to-normal-threshold = <0xffffffce>;
					temperature-normal-to-low-threshold = <0xffffffb0>;
					id-range = <0x20d 0x53f>;
					id-number = <0x01>;
				};

				id0 {
					temperature-low-parameters = <0xaf59 0x4d84 0x2484>;
					temperature-normal-parameters = <0x964c 0x68 0x00>;
					temperature-low-to-normal-threshold = <0xffffffe2>;
					temperature-normal-to-low-threshold = <0xffffffce>;
					id-range = <0x00 0x20c>;
					id-number = <0x00>;
				};
			};
		};
	};

