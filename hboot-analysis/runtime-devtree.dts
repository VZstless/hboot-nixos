			clock {
				compatible = "ti,palmas-clk";

				clk32k_kg_audio {
					ti,clock-boot-enable;
				};

				clk32k_kg {
					ti,clock-boot-enable;
				};
			};

			gpadc {
				interrupts = <0x12 0x00 0x10 0x00 0x11 0x00>;
				interrupt-parent = <0x05>;
				compatible = "ti,palmas-gpadc";

				iio_map {

					ch10 {
						ti,adc-consumer-channel = "charger-vbus";
						ti,adc-consumer-device = "bq2419x";
						ti,adc-channel-number = <0x0a>;
					};

					ch4 {
						ti,adc-consumer-channel = "hs_channel";
						ti,adc-consumer-device = "HTC_HEADSET_PMIC";
						ti,adc-channel-number = <0x04>;
					};

					ch0 {
						ti,adc-consumer-channel = "batt-id-channel";
						ti,adc-consumer-device = "bq2419x";
						ti,adc-channel-number = <0x00>;
					};
				};
			};

			power_pm {
				boot-up-at-vbus;
				system-pmic-power-off;
				compatible = "ti,palmas-pm";
			};

			extcon {
				ti,enable-vbus-detection;
				ti,wakeup;
				extcon-name = "palmas-extcon";
				compatible = "ti,palmas-usb";
			};

			pinmux {
				pinctrl-0 = <0x06>;
				pinctrl-names = "default";
				compatible = "ti,tps65913-pinctrl";

				pinmux {
					phandle = <0x06>;
					linux,phandle = <0x06>;

					pin_gpio5 {
						function = "clk32kgaudio";
						pins = "gpio5";
					};

					pin_gpio6 {
						function = "gpio";
						pins = "gpio2", "gpio3", "gpio4", "gpio6", "gpio7";
					};

					pin_gpio1 {
						function = "vbus_det";
						pins = "gpio1";
					};

					pin_gpio0 {
						bias-pull-up;
						function = "id";
						pins = "gpio0";
					};

					vac {
						function = "vac";
						pins = "vac";
					};

					powergood {
						function = "powergood";
						pins = "powergood";
					};
				};
			};

			rtc {
				interrupts = <0x08 0x00>;
				interrupt-parent = <0x05>;
				compatible = "ti,palmas-rtc";
			};

			gpio {
				phandle = <0x12>;
				linux,phandle = <0x12>;
				v_boost_bypass_gpio = <0x04>;
				ti,enable-boost-bypass;
				#gpio-cells = <0x02>;
				gpio-controller;
				compatible = "ti,palmas-gpio";
			};
		};
	};

	i2c@7000c700 {
		clock-frequency = <0x61a80>;
		status = "okay";
		nvidia,memory-clients = <0x0e>;
