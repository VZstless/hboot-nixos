	dma@60020000 {
		phandle = <0x03>;
		linux,phandle = <0x03>;
		#dma-cells = <0x01>;
		interrupts = <0x00 0x68 0x04 0x00 0x69 0x04 0x00 0x6a 0x04 0x00 0x6b 0x04 0x00 0x6c 0x04 0x00 0x6d 0x04 0x00 0x6e 0x04 0x00 0x6f 0x04 0x00 0x70 0x04 0x00 0x71 0x04 0x00 0x72 0x04 0x00 0x73 0x04 0x00 0x74 0x04 0x00 0x75 0x04 0x00 0x76 0x04 0x00 0x77 0x04 0x00 0x80 0x04 0x00 0x81 0x04 0x00 0x82 0x04 0x00 0x83 0x04 0x00 0x84 0x04 0x00 0x85 0x04 0x00 0x86 0x04 0x00 0x87 0x04 0x00 0x88 0x04 0x00 0x89 0x04 0x00 0x8a 0x04 0x00 0x8b 0x04 0x00 0x8c 0x04 0x00 0x8d 0x04 0x00 0x8e 0x04 0x00 0x8f 0x04>;
		reg = <0x00 0x60020000 0x00 0x1400>;
		compatible = "nvidia,tegra124-apbdma";
	};

	clock {
		phandle = <0x09>;
		linux,phandle = <0x09>;
		#clock-cells = <0x01>;
		reg = <0x00 0x60006000 0x00 0x1000>;
		compatible = "nvidia,tegra124-car";
	};

	se@70012000 {
		interrupts = <0x00 0x3a 0x04>;
		reg = <0x00 0x70012000 0x00 0x2000 0x00 0x7000e400 0x00 0x400>;
		compatible = "nvidia,tegra124-se";
	};

	gpio@6000d000 {
		phandle = <0x04>;
		linux,phandle = <0x04>;
		gpio-init-0 = <0x02>;
		gpio-init-names = "default";
		interrupt-controller;
		#interrupt-cells = <0x02>;
		gpio-controller;
		#gpio-cells = <0x02>;
		interrupts = <0x00 0x20 0x04 0x00 0x21 0x04 0x00 0x22 0x04 0x00 0x23 0x04 0x00 0x37 0x04 0x00 0x57 0x04 0x00 0x59 0x04 0x00 0x7d 0x04>;
		reg = <0x00 0x6000d000 0x00 0x1000>;
		compatible = "nvidia,tegra124-gpio", "nvidia,tegra30-gpio";

		default {
			phandle = <0x02>;
			linux,phandle = <0x02>;
			gpio-output-high = <0x0c 0x43 0x95 0x88 0x3d 0x82 0x84>;
			gpio-output-low = <0x3a 0x3b 0x3e 0x3f 0x40 0x4f 0x93 0x50 0x51 0x55 0x70 0x76 0x83 0x89 0x8a 0x8d 0x93 0x96 0xa3 0xab 0xb9 0xbb 0xbc 0xbd 0xbf 0xdb 0xdd 0xdf 0xf1>;
			gpio-input = <0x17 0x07 0x32 0x33 0x45 0x46 0x48 0x52 0x53 0x6c 0x72 0x73 0x75 0x77 0x81 0x86 0x87 0x8c 0x90 0x91 0x94 0xa5 0xa6 0xa8 0xa9 0xb2 0x80 0x85 0xaa 0x92 0xb3 0xde 0xe1 0xe2>;
		};
	};

	aliases {
		spi5 = "/spi@7000de00";
		spi4 = "/spi@7000dc00";
		spi3 = "/spi@7000da00";
		spi2 = "/spi@7000d800";
		spi1 = "/spi@7000d600";
		spi0 = "/spi@7000d400";
		serial3 = "/serial@70006300";
		serial2 = "/serial@70006200";
		serial1 = "/serial@70006040";
		serial0 = "/serial@70006000";
		i2c5 = "/i2c@7000d100";
		i2c4 = "/i2c@7000d000";
		i2c3 = "/i2c@7000c700";
		i2c2 = "/i2c@7000c500";
		i2c1 = "/i2c@7000c400";
		i2c0 = "/i2c@7000c000";
	};

	denver_power_states {
		phandle = <0x0b>;
		linux,phandle = <0x0b>;
		compatible = "nvidia,denver";

		cc6 {
			pmstate = <0x10>;
			power = <0x0a>;
			residency = <0x3e80>;
			latency = <0xb4>;
			state-name = "Virtual Retention";
		};

		cc4 {
			pmstate = <0x09>;
			power = <0x13>;
			residency = <0x7d0>;
			latency = <0x1f4>;
			state-name = "Retention";
		};

		c1 {
			pmstate = <0x00>;
			power = <0x46>;
			residency = <0x01>;
			latency = <0x01>;
			state-name = "Clock gated";
		};
	};
};
