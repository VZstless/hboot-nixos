	spi@7000d600 {
		dma-names = "rx", "tx";
		dmas = <0x03 0x10 0x03 0x10>;
		status = "disabled";
		clocks = <0x09 0x2c>;
		#size-cells = <0x00>;
		#address-cells = <0x01>;
		nvidia,memory-clients = <0x0e>;
		nvidia,dma-request-selector = <0x03 0x10>;
		interrupts = <0x00 0x52 0x04>;
		reg = <0x00 0x7000d600 0x00 0x200>;
		compatible = "nvidia,tegra114-spi";
	};

	spi@7000d400 {
		spi-max-frequency = <0x17d7840>;
		dma-names = "rx", "tx";
		dmas = <0x03 0x0f 0x03 0x0f>;
		status = "okay";
		clocks = <0x09 0x29>;
		#size-cells = <0x00>;
		#address-cells = <0x01>;
		nvidia,memory-clients = <0x0e>;
		nvidia,dma-request-selector = <0x03 0x0f>;
		interrupts = <0x00 0x3b 0x04>;
		reg = <0x00 0x7000d400 0x00 0x200>;
		compatible = "nvidia,tegra114-spi";
	};

	i2c@7000d100 {
		clock-frequency = <0x61a80>;
		status = "okay";
		nvidia,memory-clients = <0x0e>;
		interrupts = <0x00 0x3f 0x04>;
		reg = <0x00 0x7000d100 0x00 0x100>;
		compatible = "nvidia,tegra124-i2c";
		#size-cells = <0x00>;
		#address-cells = <0x01>;
	};

	i2c@7000d000 {
		nvidia,bit-banging-xfer-after-shutdown;
		clock-frequency = <0x61a80>;
		status = "okay";
		nvidia,memory-clients = <0x0e>;
		sda-gpio = <0x04 0xcf 0x00>;
		scl-gpio = <0x04 0xce 0x00>;
		nvidia,require-cldvfs-clock;
		interrupts = <0x00 0x35 0x04>;
		reg = <0x00 0x7000d000 0x00 0x100>;
		compatible = "nvidia,tegra124-i2c";
		#size-cells = <0x00>;
		#address-cells = <0x01>;

		tps65913 {
			phandle = <0x05>;
			linux,phandle = <0x05>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			interrupts = <0x00 0x56 0x00>;
			reg = <0x58>;
			compatible = "ti,palmas";

			voltage_monitor {
				ti,use-vbat-monitor;
				compatible = "ti,palmas-voltage-monitor";
			};

			pmic {
				ti,disable-smps10-in-suspend;
				ldoln-in-supply = <0x08>;
				ldo7-in-supply = <0x07>;
				ldo5-in-supply = <0x07>;
				ldo2-in-supply = <0x07>;
				compatible = "ti,tps65913-pmic", "ti,palmas-pmic";

				regulators {

					ldousb {
						regulator-boot-on;
						regulator-always-on;
						regulator-max-microvolt = <0x325aa0>;
						regulator-min-microvolt = <0x325aa0>;
						regulator-name = "avdd-usb";

						consumers {

							c8 {
								regulator-consumer-device = "tegra-pcie";
								regulator-consumer-supply = "hvdd_pex_pll_e";
							};

							c7 {
								regulator-consumer-device = "tegra-pcie";
								regulator-consumer-supply = "hvdd_pex";
							};

							c6 {
								regulator-consumer-device = "tegra-xhci";
								regulator-consumer-supply = "hvdd_usb";
							};

							c5 {
								regulator-consumer-device = "tegra-ehci.2";
								regulator-consumer-supply = "avdd_usb";
							};

							c4 {
								regulator-consumer-device = "tegra-ehci.1";
								regulator-consumer-supply = "avdd_usb";
							};

							c3 {
								regulator-consumer-device = "tegra-ehci.0";
								regulator-consumer-supply = "avdd_usb";
							};

							c2 {
								regulator-consumer-device = "tegra-udc.0";
								regulator-consumer-supply = "avdd_usb";
							};

							c1 {
								regulator-consumer-supply = "pwrdet_pex_ctl";
							};
						};
					};

					ldoln {
						ti,roof-floor = <0x03>;
						regulator-max-microvolt = <0x325aa0>;
						regulator-min-microvolt = <0x325aa0>;
						regulator-name = "vddio-hv";

						consumers {

							c1 {
								regulator-consumer-supply = "pwrdet_hv";
							};
						};
					};

					ldo9 {
						regulator-max-microvolt = <0x325aa0>;
						regulator-min-microvolt = <0x1b7740>;
						regulator-name = "vdd-3p3-ldo9";

						consumers {
						};
					};

					ldo8 {
						regulator-boot-on;
						regulator-always-on;
						regulator-max-microvolt = <0xe7ef0>;
						regulator-min-microvolt = <0xe7ef0>;
						regulator-name = "vdd-rtc";

						consumers {

							c1 {
								regulator-consumer-supply = "vdd_rtc";
							};
